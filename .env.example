# Copie para .env e preencha. Nunca versione o .env com valores reais.

# Supabase (cliente)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase (servidor)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transcrição com tempos por palavra
ASSEMBLYAI_API_KEY=

# IA: gateway com vários fornecedores (src/lib/ai). Só é preciso a chave dos que usar.
# Ordem: principal, reserva e segunda reserva. Um fornecedor sem chave fica de fora.
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=
AI_FALLBACK_2_PROVIDER=

OPENAI_API_KEY=
# Modelo OpenAI de todos os níveis (por omissão gpt-5.6-luna)
AI_CHAT_MODEL=
# Opcional: base alternativa compatível com a API da OpenAI
AI_BASE_URL=
# Modelo de imagens (capas, oferta, produto); por omissão gpt-image-1
AI_IMAGE_MODEL=

# Google Gemini (por omissão: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-3.8-pro)
GEMINI_API_KEY=

# Anthropic Claude (por omissão: claude-haiku-4-5, claude-sonnet-5, claude-opus-5)
ANTHROPIC_API_KEY=
# Opcional: "on" deixa a própria Anthropic repetir uma recusa noutro modelo Claude, dentro do
# mesmo pedido. Desligado: a cadeia de reservas é a do gateway (AI_FALLBACK_PROVIDER...).
ANTHROPIC_REFUSAL_FALLBACK=

# Opcional: modelo por nível de cada fornecedor. O router escolhe o nível pela tarefa:
# rápido (classificação, intenção, resumo), equilibrado (chat, geração, análise),
# capaz (raciocínio complexo).
# OPENAI_MODEL_FAST=  OPENAI_MODEL=  OPENAI_MODEL_CAPABLE=
# GEMINI_MODEL_FAST=  GEMINI_MODEL=  GEMINI_MODEL_CAPABLE=
# ANTHROPIC_MODEL_FAST=  ANTHROPIC_MODEL=  ANTHROPIC_MODEL_CAPABLE=

# Saldo de IA: custo real do fornecedor (USD) + margem. Sem os preços de texto, nada é cobrado.
# Copie os valores da página de preços do seu fornecedor para o modelo em AI_CHAT_MODEL.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Os dois preços acima são os do modelo em AI_CHAT_MODEL, e só desse.
# Preço de cada outro modelo, em USD por milhão de tokens [entrada, saída]. Um modelo sem preço
# não é cobrado e fica em ai_calls com o custo por saber (nunca como zero).
# Confirmar na página de preços de cada fornecedor. Exemplo com os preços da Anthropic:
# AI_MODEL_PRICES={"claude-haiku-4-5":[1,5],"claude-sonnet-5":[2,10],"claude-opus-5":[5,25]}
AI_MODEL_PRICES=
AI_PRICE_PER_IMAGE=
TRANSCRIPTION_PRICE_PER_HOUR=
AI_MARGIN=0.4

# Recargas de créditos de IA: segredo que a conta Kambafy da plataforma envia em
# `x-webhook-secret` para /api/public/billing-webhook. Sem ele, o webhook responde 503.
BILLING_WEBHOOK_SECRET=

# Opcional: domínio público das salas e subdomínio de administração
VITE_PUBLIC_APP_URL=
VITE_ADMIN_HOST=
VITE_PUBLIC_HOSTS=

# Opcional: WhatsApp não oficial pelo WAHA (github.com/devlikeapro/waha), uma sessão por organização.
WAHA_URL=
WAHA_API_KEY=

# Opcional: "off" desliga o motor interno da fila de trabalhos. Usar só quando a fila
# é empurrada por uma chamada agendada a /api/public/run-jobs (alojamento serverless).
JOB_TICKER=
